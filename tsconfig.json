{
    "compilerOptions": {
        "types": ["node", "jest"],
        "rootDir": "./src",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "target": "es2022",
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": false,
        "sourceMap": true,
        "lib": ["es2022"],
        "outDir": "./lib",
        "typeRoots": [
            "node_modules/@types"
        ],
        "declaration": true
    },
    "exclude": [
        "lib",
        "node_modules"
    ]
}